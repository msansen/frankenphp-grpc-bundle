{
  "name": "msansen/frankenphp-grpc-bundle",
  "description": "Symfony integration for FrankenPHP gRPC handlers using PHP arrays and attribute-based routing.",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthieu Sansen",
      "email": "matt@sansen.dev"
    }
  ],
  "keywords": [
    "symfony",
    "bundle",
    "grpc",
    "frankenphp",
    "protobuf"
  ],
  "require": {
    "php": ">=8.2",
    "psr/container": "^1.1 || ^2.0",
    "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
    "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
    "symfony/config": "^6.4 || ^7.4 || ^8.0",
    "symfony/service-contracts": "^2.5 || ^3.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "FrankenPhpGrpcBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FrankenPhpGrpcBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
